@startuml
skinparam rectangle {
  BorderColor Black
  BackgroundColor #F9F9F9
}
skinparam shadowing false

actor User as U
rectangle "Groq API\n(LLM Server)" as GROQ

rectangle "ChatBot.jsx" {

    rectangle "State Management\n- messages\n- input\n- isLoading" as STATE

    rectangle "sendMessage()" as SEND

    rectangle "queryProcessor.processQuery()\n----------------------------\n• Parse natural language\n• Match keywords\n• Query local JSON\n• Return structured result" as QP

    rectangle "Build Enhanced Prompt\n----------------------------\nUser Question\n+ Local Data Result\n+ Insight" as PROMPT

    rectangle "groq.chat.completions.create()\nmodel: llama-3.3-70b-versatile\ntemperature: 0.7\nmax_tokens: 1024" as API

    rectangle "setMessages()\nRender response to UI" as RENDER
}

U --> STATE : 1. Type question
STATE --> SEND
SEND --> QP : 2
QP --> PROMPT : 3. Local result
PROMPT --> API : 4. API call
API --> GROQ
GROQ --> API : 5. AI response
API --> RENDER

@enduml
